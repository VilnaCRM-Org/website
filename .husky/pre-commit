set -e

# Fast, staged-file scope: Prettier + ESLint only on what is about to land.
bun x lint-staged

# Types are non-local (a change in one file can break another), so the type
# check runs over the whole project. EXEC_MODE=host runs the host toolchain
# directly, so the hook works without the Docker dev stack running.
EXEC_MODE=host make lint-tsc
