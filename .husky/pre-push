set -e

# Full local gate before the commits leave the machine. This is a strict
# superset of the previous pre-commit surface (it adds lint-deps via `make
# lint`). EXEC_MODE=host runs the host toolchain directly, so the hook works
# without the Docker dev stack running.
EXEC_MODE=host make format
EXEC_MODE=host make lint
EXEC_MODE=host make test-unit-all
