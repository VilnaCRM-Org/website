.git
.idea
.vscode
.stryker-tmp

# The `base` stage installs /app/node_modules itself; without this the
# `build` stage's `COPY . .` would overwrite it with the host tree — whose
# native binaries are built for the developer's platform, not the image's —
# and upload ~1.5 GB of context on every build.
node_modules

coverage
playwright-report
stryker.log
**/test-results

.cache
*.log

storybook-static

# The dockerfile-performance CI job checks out the base branch into ./base to
# compare image size/build time. Keep it out of the build context so the head
# image isn't polluted with the base branch's sources (which would otherwise be
# type-checked against head modules and can break `next build`).
base/