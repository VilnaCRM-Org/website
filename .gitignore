# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# generated i18n bundle (rebuilt by the next.config webpack hook and the Jest
# globalSetup; see scripts/localizationGenerator.js)
pages/i18n/localization.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
./tsconfig.tsbuildinfo

/.idea
.vsco

#lighthouse
.lighthouseci/
/lhci-reports-desktop
/lhci-reports-mobile

.vscode

storybook-static/
storybook-static-ci/
/test-results/
# Burn-in reports sit outside test-results so the flake grader never sweeps both cohorts
# into one recursive walk (see E2E_BURNIN_REPORT_DIR in the Makefile).
/burn-in-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# stryker temp files
.stryker-tmp
/reports/

# k6 config
/src/test/load/config.json
/src/test/load/results

# memlab
/src/test/memory-leak/results

app.log
*.log

/public/swagger-schema.*

# Dockerfile build-performance gate (scripts/ci/docker_perf.sh) artifacts
/.docker-perf/

# Host-mode prod server state (scripts/ci/host-stack.sh, HOST_STACK=1): the pid
# that makes `stop-prod` idempotent and the serve log a background failure would
# otherwise be lost in.
/.host-stack/

# rust-code-analysis host binary (scripts/ci/ensure-rca.sh) — provisioned on
# demand, pinned + SHA256-verified, never committed (it is not an npm dep).
/bin/

# Local directories generated by the BMAD agent tool (bmalph) — local-only, not committed.
# Only the produced artifacts under specs/ are committed. The repo-local AI-agent docs
# (CLAUDE.md, cursor-project-guide.md, and .claude/skills/**) ARE committed; only bmalph's
# generated slash-command stubs under .claude/commands/ stay local.
/_bmad/
/_bmad-output/
/bmalph/
/.ralph/
/.claude/commands/

# draw.io diagrams. An AWS IoT reference architecture unrelated to this
# S3 + CloudFront static export was committed at the repo root and later moved to
# docs/ (issue #383); internal infrastructure diagrams aid attacker recon and
# belong in a private design store, not a public repository.
*.drawio
*.drawio.bkp
*.drawio.dtmp
