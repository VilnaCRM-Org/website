{
  "name": "VilnaCRM website",

  // Reuses the same `base` stage docker-compose.yml builds for the dev service
  // instead of an image + Features stack. `base` is where the Node, Bun and
  // build-toolchain versions are already declared exactly once, and it
  // deliberately does not COPY the source — the workspace arrives through the
  // bind mount below. Naming a runtime version here would fork a pin that the
  // Dockerfile, .nvmrc, .bun-version and package.json already carry.
  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile",
    "target": "base"
  },

  // The image WORKDIR is /app and every compose service, Makefile path and
  // healthcheck assumes it, so the workspace is mounted there rather than at the
  // /workspaces default.
  "workspaceFolder": "/app",
  "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind",

  // The Dockerfile declares no USER: /app and the global npm prefix are
  // root-owned, so a non-root remoteUser could write to neither.
  "remoteUser": "root",

  "remoteEnv": {
    // Host mode for the Makefile. Without it every target prefixes itself with a
    // `docker compose exec dev`, i.e. this container trying to exec into itself
    // with no Docker socket.
    "CI": "1",
    // The rest mirrors what docker-compose.yml gives the `dev` service, so the
    // two environments do not drift: inotify does not propagate through a bind
    // mount on Docker Desktop or Codespaces, and without polling `next dev`
    // silently stops hot-reloading there.
    "NODE_ENV": "development",
    "CHOKIDAR_USEPOLLING": "true",
    "WATCHPACK_POLLING": "true"
  },

  // Catches a stale cached image whose Node no longer satisfies package.json
  // "engines" here, instead of as a confusing failure inside a later build.
  "onCreateCommand": "node checkNodeVersion.js",

  // Three things the container is unusable without, in order:
  //   * bash — the Alpine base ships only busybox ash, but `devcontainer exec`
  //     (how CI and editors run a command in here) hardcodes `bash -c`.
  //   * node_modules — the bind mount shadows the image's build-time install.
  //     `make install` is deliberately not used: it re-runs the Node guard above.
  //   * pages/i18n/localization.json — generated and gitignored (#328), and
  //     dependency-cruiser resolves its `require` statically, so `make lint`
  //     fails on a fresh container without it.
  "postCreateCommand": "apk add --no-cache bash && bun install --frozen-lockfile && node scripts/generateLocalization.mjs",

  "forwardPorts": [3000, 3001, 4000, 6006, 8080],
  "portsAttributes": {
    "3000": { "label": "next dev server" },
    "3001": { "label": "static export (serve)" },
    "4000": { "label": "apollo graphql mock" },
    "6006": { "label": "storybook" },
    "8080": { "label": "mockoon api mock" }
  },

  // No "features" block on purpose: Features are referenced by floating version
  // tags, and this repo SHA-pins every third-party dependency and is scored on
  // OpenSSF Scorecard's pinned-dependencies check. The base image already
  // provides the toolchain a Feature would install.
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "EditorConfig.EditorConfig",
        "DavidAnson.vscode-markdownlint"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.eol": "\n"
      }
    }
  }
}
